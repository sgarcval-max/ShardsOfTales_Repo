  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogo
  panelDialogo: {fileID: 1241233653}
  textoDialogo: {fileID: 1991709001}
  avisoInteractuar: {fileID: 399648700}
  player: {fileID: 1380883099}
  lineas:
  - Ay... estoy enfermo y no puedo salir de la torre.
  - Toma mi flauta, la vas a necesitar.
  - "Mi partitura est\xE1 en el cofre del primer piso, pero est\xE1 cerrado."
  - Busca la llave en el segundo piso.
  - (Has recibido la flauta)
  lineasDespues:
  - Busca la llave en el segundo piso y abre el cofre del primer piso.
