  m_Script: {fileID: 11500000, guid: 39679fd3fc03c7d41b0385bf130c8b04, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCNinoSordo
  panelDialogo: {fileID: 1632086907}
  textoDialogo: {fileID: 1986482756}
  avisoInteractuar: {fileID: 1978540818}
  player: {fileID: 304231706}
  lineasSinPapel:
  - "(El ni\xF1o te mira y mueve los labios, pero no oye nada de lo que le dices.)"
  - "(No hay forma de hablar con \xE9l. Quiz\xE1 escribiendo...)"
  - (Necesitas papel y algo con que escribir. Tal vez en el pueblo.)
  lineasAyuda:
  - "(Le entregas el papel y el bol\xEDgrafo.)"
  - "Ni\xF1o: Gracias. Los dem\xE1s ni\xF1os siguieron el camino del bosque, hacia
    la monta\xF1a."
  - "(Ya sabes hacia d\xF3nde seguir.)"
  lineasDespues:
  - "Ni\xF1o: Sigue el camino hacia la monta\xF1a. \xA1Suerte!"
