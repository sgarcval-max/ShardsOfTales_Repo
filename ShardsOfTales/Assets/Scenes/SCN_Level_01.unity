  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcName: "Flautista de Hamel\xEDn"
  maxInteractDistance: 5
  initialDialogue:
  - "\xA1Cof, cof! Estoy demasiado enfermo para tocar la flauta hoy.."
  - "Las ratas invaden Hamel\xEDn. Toma mi sombrero y hazte pasar por m\xED."
  - Cruza el puente al fondo del camino y recoge mi partitura para hipnotizarlas.
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1273517830}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
      - m_Target: {fileID: 686259878}
        m_TargetAssemblyTypeName: StoryProgressManager, Assembly-CSharp
        m_MethodName: EquipPiperDisguise
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  secondaryDialogue:
  - "\xA1Esa es mi partitura! Date prisa, toca la melod\xEDa."
  - "Pulsa ESPACIO cuando la nota pase por el c\xEDrculo dorado para hipnotizar a
    las ratas."
  onSecondaryDialogueFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 686259877}
        m_TargetAssemblyTypeName: RatMinigameController, Assembly-CSharp
        m_MethodName: StartMinigame
